extends TestCase
## Card studio: picture model (tools, undo, mirror, import) and the submission seam.

func run() -> void:
	var p := CardPixels.new()
	assert_eq(p.image.get_width(), CardView.ART_WIN.size.x, "picture width = card art window")
	assert_eq(p.image.get_height(), CardView.ART_WIN.size.y, "picture height = card art window")
	assert_true(p.is_blank(), "starts blank")
	var red := Color("#d0443a")
	p.begin_action()
	p.dab(Vector2i(3, 4), red, 1, true)
	assert_true(p.get_px(Vector2i(3, 4)).is_equal_approx(red), "dab paints")
	assert_true(p.get_px(Vector2i(CardPixels.W - 4, 4)).is_equal_approx(red), "mirror paints the other side")
	p.begin_action()
	p.line(Vector2i(0, 0), Vector2i(10, 5), red)
	assert_true(p.get_px(Vector2i(10, 5)).is_equal_approx(red), "line reaches its end")
	assert_true(p.undo(), "undo works")
	assert_true(p.get_px(Vector2i(10, 5)).a == 0.0, "undo removes the line")
	assert_true(p.redo(), "redo works")
	assert_true(p.get_px(Vector2i(10, 5)).is_equal_approx(red), "redo restores the line")
	p.begin_action()
	p.clear()
	p.rect(Vector2i(10, 10), Vector2i(20, 20), red)
	p.fill(Vector2i(15, 15), Color.WHITE)
	assert_true(p.get_px(Vector2i(15, 15)).is_equal_approx(Color.WHITE), "fill fills inside a box")
	assert_true(p.get_px(Vector2i(0, 0)).a == 0.0, "fill stays inside the box")
	assert_eq(CardPixels.rect_points(Vector2i(0, 0), Vector2i(2, 2), false).size(), 8, "box outline has 8 px")
	# import: a 200x100 image fits the window, keeps aspect, uses only palette colours
	var src := Image.create_empty(200, 100, false, Image.FORMAT_RGBA8)
	src.fill(Color(0.81, 0.27, 0.22))
	p.import_image(src)
	assert_true(p.get_px(Vector2i(32, 25)).is_equal_approx(red), "import snaps to the palette")
	assert_true(p.get_px(Vector2i(32, 0)).a == 0.0, "import letterboxes")
	# submission seam
	assert_eq(CardSubmission.validate("", p.image), ["name"] as Array[String], "empty name refused")
	assert_eq(CardSubmission.validate("불꽃", CardPixels.new().image), ["picture"] as Array[String], "blank picture refused")
	var pl := CardSubmission.payload(" 불꽃 ", p.image)
	assert_eq(pl["name"], "불꽃", "name trimmed")
	var back := Image.new()
	back.load_png_from_buffer(Marshalls.base64_to_raw(pl["picture_png_base64"]))
	assert_eq(back.get_size(), Vector2i(CardPixels.W, CardPixels.H), "payload picture round-trips")
	var s := CardSubmission.new()
	var got := []
	s.finished.connect(func(r): got.append(r))
	s.submit("불꽃", p.image)
	assert_true(got.size() == 1 and got[0]["ok"] and got[0]["local"], "no endpoint -> saved locally")
	assert_true(FileAccess.file_exists("user://card_submissions/%s/card.json" % got[0]["id"]), "card.json written")
	assert_true(CardStudio.name_fits("화염구"), "short name fits the plate")
	assert_true(not CardStudio.name_fits("아주아주아주아주긴이름입니다"), "long name refused")
