extends TestCase

class FakeUnit extends RefCounted:
	var pos := Vector2i(-1, -1)

func run() -> void:
	var c := Catalog.load_dir("res://data")
	var g := Grid.new(c)
	var p := Vector2i(4, 3)
	assert_true(g.states_at(p).is_empty(), "cells start with no state")
	g.add_state(p, "heat")
	assert_true(g.has_state(p, "heat"), "heat on")
	g.add_state(p, "cold")
	assert_true(not g.has_state(p, "heat") and not g.has_state(p, "cold"), "heat and cold cancel")
	g.add_state(p, "heat"); g.add_state(p, "heat", -1.0, Vector2i.ZERO, true)
	assert_true(g.has_state(p, "blaze") and not g.has_state(p, "heat"), "heat laid on heat grows into blaze")
	g.add_state(p, "gust", -1.0, Vector2i.RIGHT)
	assert_eq(g.state_dir(p, "gust"), Vector2i.RIGHT, "directional state keeps its direction")
	g.add_state(p, "slow")
	assert_eq(g.time_scale(p), 0.5, "slow halves time")
	g.add_state(p, "haste")
	assert_eq(g.time_scale(p), 1.5, "haste replaces slow")
	g.clear_state(p, "haste")
	assert_eq(g.time_scale(p), 1.0, "cleared")
	g.clear_state(p, "blaze"); g.clear_state(p, "gust")
	assert_true(not g.in_bounds(Vector2i(9, 0)), "x=9 out of bounds")
	assert_true(g.in_bounds(Vector2i(8, 6)), "corner in bounds")
	assert_eq(g.neighbors4(Vector2i(0, 0)).size(), 2, "corner has 2 neighbors")
	g.set_material(Vector2i(1, 1), "wall")
	var u := FakeUnit.new()
	assert_true(not g.place_unit(u, Vector2i(1, 1)), "cannot place on wall")
	assert_true(g.place_unit(u, Vector2i(2, 2)), "place ok")
	assert_eq(u.pos, Vector2i(2, 2), "unit pos updated")
	var u2 := FakeUnit.new()
	assert_true(not g.place_unit(u2, Vector2i(2, 2)), "cannot place on occupied")
	assert_true(g.unit_at(Vector2i(2, 2)) == u, "unit_at")
	assert_true(g.move_unit(u, Vector2i(3, 2)), "move ok")
	assert_true(g.unit_at(Vector2i(2, 2)) == null, "old cell empty")
	var snap := g.duplicate_state()
	g.add_state(p, "crush")
	g.set_material(p, "oil")
	g.move_unit(u, Vector2i(5, 5))
	g.restore_state(snap)
	assert_true(not g.has_state(p, "crush"), "restore state")
	assert_eq(g.get_material(p), "none", "restore material")
	assert_eq(u.pos, Vector2i(3, 2), "restore unit position")
	assert_true(g.unit_at(Vector2i(3, 2)) == u, "restore occupancy")
	g.remove_unit(u)
	assert_true(g.unit_at(Vector2i(3, 2)) == null, "removed")
