[
  {"id": "water_freezes", "when": [{"material": "water"}, {"state": "cold"}], "then": [{"set_material": "ice"}, {"clear_state": "cold"}]},
  {"id": "water_boils", "when": [{"material": "water"}, {"state": "heat"}], "then": [{"set_material": "steam"}, {"clear_state": "heat"}, {"add_state": "damp"}]},
  {"id": "water_boils_blaze", "when": [{"material": "water"}, {"state": "blaze"}], "then": [{"set_material": "steam"}, {"add_state": "damp"}]},
  {"id": "steam_condenses", "when": [{"material": "steam"}, {"state": "cold"}], "then": [{"set_material": "water"}, {"clear_state": "cold"}]},
  {"id": "ice_melts", "when": [{"material": "ice"}, {"state": "heat"}], "then": [{"set_material": "water"}, {"clear_state": "heat"}]},
  {"id": "ice_melts_blaze", "when": [{"material": "ice"}, {"state": "blaze"}], "then": [{"set_material": "water"}]},
  {"id": "oil_ignites_heat", "when": [{"material": "oil"}, {"state": "heat"}], "then": [{"set_material": "fire"}]},
  {"id": "oil_ignites_blaze", "when": [{"material": "oil"}, {"state": "blaze"}], "then": [{"set_material": "fire"}]},
  {"id": "oil_catches_fire", "when": [{"material": "oil"}, {"neighbor_material": "fire"}], "then": [{"set_material": "fire"}]},
  {"id": "gas_explodes", "when": [{"material": "gas_flammable"}, {"neighbor_material": "fire"}], "then": [{"set_material": "fire"}, {"add_state": "crush"}, {"damage_units": 10, "kind": "fire"}]},
  {"id": "fire_doused", "when": [{"material": "fire"}, {"state": "damp"}], "then": [{"set_material": "steam"}, {"clear_state": "damp"}]},
  {"id": "fire_chilled", "when": [{"material": "fire"}, {"state": "cold"}], "then": [{"set_material": "smoke"}, {"clear_state": "cold"}]},
  {"id": "fire_heats", "when": [{"material": "fire"}], "then": [{"add_state": "heat"}, {"status_to_units": "burning", "turns": 2}]},
  {"id": "smoke_clears", "when": [{"material": "smoke"}], "then": [{"set_material": "none"}]},
  {"id": "steam_settles", "when": [{"material": "steam"}], "then": [{"add_state": "damp"}]},
  {"id": "blaze_burns", "when": [{"state": "blaze"}], "then": [{"status_to_units": "burning", "turns": 2}, {"damage_units": 4, "kind": "fire"}]},
  {"id": "cold_freezes_wet", "when": [{"state": "cold"}, {"status": "wet"}], "then": [{"status_to_units": "frozen", "turns": 1}]},
  {"id": "crystal_shatters", "when": [{"material": "crystal"}, {"state": "echo"}], "then": [{"set_material": "none"}, {"damage_units": 4, "kind": "physical"}]},
  {"id": "wall_collapses", "when": [{"material": "wall"}, {"state": "collapse"}], "then": [{"set_material": "none"}, {"add_state": "echo"}]},
  {"id": "collapse_crushes", "when": [{"state": "collapse"}], "then": [{"damage_units": 6, "kind": "physical"}]},
  {"id": "water_shocks", "when": [{"material": "water"}, {"state": "charged"}], "then": [{"damage_units": 5, "kind": "electric"}]},
  {"id": "charged_shocks", "when": [{"state": "charged"}], "then": [{"status_to_units": "shocked", "turns": 1}]},
  {"id": "curse_hurts", "when": [{"state": "curse"}], "then": [{"damage_units": 2, "kind": "curse"}]},
  {"id": "miasma_poisons", "when": [{"state": "miasma"}], "then": [{"status_to_units": "poisoned", "turns": 2}]}
]
